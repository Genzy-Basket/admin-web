# Logs
# Anchored: a bare "logs" also matched src/features/logs, so the whole error
# log feature was silently left out of a commit and the build failed on the
# missing module.
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local env (keep .env.example tracked)
.env
.env.local
.env.*.local
